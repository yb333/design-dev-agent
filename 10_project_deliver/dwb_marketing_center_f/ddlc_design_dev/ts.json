  "rules": {
    "R0001": {
      "rule_name": "订单指标预聚合",
      "scenario": "default",
      "exec_sequence": 1,
      "target_table": "slmar.dwb_marketing_center_order_mid_f",
      "is_view_step": false,
      "design_intent": "按 activity_id 预聚合订单指标(订单数/GMV/参与人数/优惠金额/新客占比), 将 dwd_order_f 多行(每笔订单)收敛为一行(每个活动), 防止主查询关联订单表时发散。中间表粒度=每行一个活动, 以 activity_id 为聚合键(隐式粒度键, 非 field_targets 所属)。",
      "load_mode": "truncate_table",
      "source_tables": [
        {
          "schema": "sdord",
          "table": "dwd_order_f",
          "alias": "dof"
        },
        {
          "schema": "sdmar",
          "table": "dwd_activity_f",
          "alias": "daf"
        }
      ],
      "ctes": [
        {
          "name": "user_first_order",
          "purpose": "扫描 dwd_order_f 全量订单, 按 user_id 找出每个用户的历史首单时间(MIN 下单时间), 用于判定该用户是否为某活动期间的新用户",
          "source_tables": [
            "dwd_order_f"
          ]
        }
      ],
      "grain": {
        "input": "一行=一笔订单(dwd_order_f)",
        "output": "一行=一个活动(按 activity_id 聚合)",
        "change": "多行聚合"
      },
      "joins": [
        {
          "alias": "dof",
          "type": "main",
          "condition": "",
          "filter": ""
        },
        {
          "alias": "daf",
          "type": "INNER JOIN",
          "condition": "dof.activity_id = daf.activity_id",
          "filter": "取 daf.start_time / daf.end_time 作为活动时间窗口, 用于新用户判定"
        }
      ],
      "join_safety": [
        {
          "table": "dwd_order_f",
          "join_key_unique": true,
          "strategy": "GROUP BY activity_id 收敛, 聚合后每活动一行",
          "reason": "dwd_order_f 一个 activity_id 对应多笔订单, 直接 JOIN 主查询会发散; 先按 activity_id GROUP BY 预聚合后, JOIN 键唯一"
        }
      ],
      "field_targets": [
        "order_cnt",
        "gmv_amount",
        "participant_cnt",
        "total_discount_amount",
        "new_user_rate"
      ],
      "field_logics": {
        "order_cnt": "按 activity_id 汇总活动关联订单数, 对 dwd_order_f 中该活动下的订单行计数",
        "gmv_amount": "按 activity_id 汇总活动 GMV, 对 dwd_order_f 中该活动下所有订单的 pay_amount 求和",
        "participant_cnt": "按 activity_id 统计参与人数, 对 dwd_order_f 中该活动下订单的 user_id 去重计数",
        "total_discount_amount": "按 activity_id 汇总活动优惠金额, 对 dwd_order_f 中该活动下所有订单的 discount_amount 求和",
        "new_user_rate": "新客占比百分比。分子=活动期间新用户产生的订单数, 分母=活动总订单数, 比值乘100。 新用户定义: 用户的全量历史首单时间落在该活动的开始至结束时间窗口内(即活动期间首次下单的用户)。 判定方式: 先用子查询找出每个 user_id 的历史首单时间(MIN 下单时间), 再筛选首单时间在活动 [start_time, end_time] 窗口内的用户, 统计这些用户在该活动中的订单数。总订单数为0时结果为NULL。 需关联 dwd_activity_f 取活动时间窗口。"
      }
    },
    "R0002": {
      "rule_name": "营销中心宽表组装",
      "scenario": "default",
      "exec_sequence": 2,
      "target_table": "slmar.dwb_marketing_center_f",
      "is_view_step": false,
      "design_intent": "以活动事实表(dwd_activity_f)为主表, LEFT JOIN 活动类型维度、优惠券维度和订单聚合中间表, 组装营销中心宽表全部字段。枚举翻译、比率指标、人均消费、ROI 在此规则完成。 订单相关指标全部取自 R0001 中间表, 不再直接关联订单明细表。",
      "load_mode": "truncate_table",
      "source_tables": [
        {
          "schema": "sdmar",
          "table": "dwd_activity_f",
          "alias": "daf"
        },
        {
          "schema": "dim",
          "table": "dim_activity_type_f",
          "alias": "dat"
        },
        {
          "schema": "dim",
          "table": "dim_coupon_f",
          "alias": "dcf"
        },
        {
          "schema": "sdmar",
          "table": "dwd_coupon_use_f",
          "alias": "dcu"
        }
      ],
      "ctes": [
        {
          "name": "coupon_use_agg",
          "purpose": "按 activity_id 预聚合优惠券使用事实表(dwd_coupon_use_f), 汇总优惠券核销金额, 防止 dcu 多行关联发散",
          "source_tables": [
            "dwd_coupon_use_f"
          ]
        }
      ],
      "grain": {
        "input": "一行=一个活动(dwd_activity_f)",
        "output": "一行=一个活动",
        "change": "无变化"
      },
      "joins": [
        {
          "alias": "daf",
          "type": "main",
          "condition": "",
          "filter": ""
        },
        {
          "alias": "dat",
          "type": "LEFT JOIN",
          "condition": "daf.activity_type = dat.type_code",
          "filter": ""
        },
        {
          "alias": "dcf",
          "type": "LEFT JOIN",
          "condition": "daf.activity_id = dcf.activity_id",
          "filter": ""
        },
        {
          "alias": "dcu_agg",
          "type": "LEFT JOIN",
          "condition": "daf.activity_id = dcu_agg.activity_id",
          "filter": "经由 coupon_use_agg CTE 预聚合后关联"
        },
        {
          "alias": "order_mid",
          "type": "LEFT JOIN",
          "condition": "daf.activity_id = order_mid.activity_id",
          "filter": "关联 R0001 产出的订单聚合中间表"
        }
      ],
      "join_safety": [
        {
          "table": "dim_activity_type_f",
          "join_key_unique": true,
          "strategy": "",
          "reason": "维度表, type_code 唯一, 关联不发散"
        },
        {
          "table": "dim_coupon_f",
          "join_key_unique": false,
          "strategy": "需确认 activity_id 在 dim_coupon_f 中是否唯一; 若一活动多券则需收敛(取主券或聚合)",
          "reason": "优惠券维度表按 activity_id 关联, 若一活动关联多张优惠券则直取字段(coupon_id/coupon_name 等)会歧义发散"
        },
        {
          "table": "dwd_coupon_use_f",
          "join_key_unique": false,
          "strategy": "CTE 预聚合: 按 activity_id GROUP BY 汇总优惠券核销金额后关联",
          "reason": "优惠券使用事实表一个活动对应多条使用记录, 直接关联发散"
        },
        {
          "table": "dwb_marketing_center_order_mid_f",
          "join_key_unique": true,
          "strategy": "",
          "reason": "中间表已按 activity_id GROUP BY 收敛, 每活动一行, 关联安全"
        }
      ],
      "field_targets": [
