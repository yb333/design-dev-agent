  "rules": {
    "R0001": {
      "rule_name": "供应链中心宽表写入",
      "scenario": "default",
      "exec_sequence": 1,
      "target_table": "slscc.dwb_supply_chain_center_f",
      "is_view_step": false,
      "design_intent": "以采购事实表(dp)为主表锚定粒度，LEFT JOIN 供应商/商品/仓库维度表补充属性，LEFT JOIN 库存事实表取当前库存与锁定库存，通过CTE预聚合销售表按product_id统计近30天销量后关联，计算库存周转天数，写入供应链中心宽表",
      "load_mode": "truncate_table",
      "source_tables": [
        {
          "schema": "sdinv",
          "table": "dwd_purchase_f",
          "alias": "dpf"
        },
        {
          "schema": "dim",
          "table": "dim_supplier_f",
          "alias": "dsf"
        },
        {
          "schema": "dim",
          "table": "dim_product_f",
          "alias": "dpf2"
        },
        {
          "schema": "dim",
          "table": "dim_warehouse_f",
          "alias": "dwf"
        },
        {
          "schema": "sdinv",
          "table": "dwd_inventory_f",
          "alias": "dif"
        },
        {
          "schema": "sdinv",
          "table": "dwd_sales_f",
          "alias": "dsales"
        }
      ],
      "ctes": [
        {
          "name": "sales_agg",
          "purpose": "对销售事实表(dwd_sales_f)按product_id聚合SUM统计近30天销量(sales_qty_30d)，产出商品粒度的销量汇总，避免销售明细JOIN到采购主表时发散",
          "source_tables": [
            "sdinv.dwd_sales_f"
          ]
        }
      ],
      "grain": {
        "input": "采购事实表每行=一个采购单(dp为主表)；销售事实表每行=一笔销售明细(dsales需聚合)",
        "output": "每行=一个采购单（供应链记录）",
        "change": "主表粒度不变；dsales从销售明细聚合到商品粒度后关联"
      },
      "joins": [
        {
          "alias": "dpf",
          "type": "main",
          "condition": "采购事实表（粒度锚点：采购单）",
          "filter": ""
        },
        {
          "alias": "dsf",
          "type": "LEFT JOIN",
          "condition": "dpf.supplier_id = dsf.supplier_id",
          "filter": ""
        },
        {
          "alias": "dpf2",
          "type": "LEFT JOIN",
          "condition": "dpf.product_id = dpf2.product_id",
          "filter": ""
        },
        {
          "alias": "dwf",
          "type": "LEFT JOIN",
          "condition": "dpf.warehouse_id = dwf.warehouse_id",
          "filter": ""
        },
        {
          "alias": "dif",
          "type": "LEFT JOIN",
          "condition": "dpf.product_id = dif.product_id AND dpf.warehouse_id = dif.warehouse_id",
          "filter": ""
        },
        {
          "alias": "sales_agg",
          "type": "LEFT JOIN",
          "condition": "dpf.product_id = sales_agg.product_id",
          "filter": "CTE预聚合结果，已按product_id收敛唯一"
        }
      ],
      "join_safety": [
        {
          "table": "dim_supplier_f",
          "join_key_unique": true,
          "strategy": "直接关联",
          "reason": "供应商维度表按supplier_id唯一"
        },
        {
          "table": "dim_product_f",
          "join_key_unique": true,
          "strategy": "直接关联",
          "reason": "商品维度表按product_id唯一"
        },
        {
          "table": "dim_warehouse_f",
          "join_key_unique": true,
          "strategy": "直接关联",
          "reason": "仓库维度表按warehouse_id唯一"
        },
        {
          "table": "dwd_inventory_f",
          "join_key_unique": true,
          "strategy": "直接关联",
          "reason": "库存事实表按product_id+warehouse_id粒度取当前库存快照（stock_qty/locked_qty为当前状态值），假设唯一；若存在批次级库存需改为GROUP BY收敛"
        },
        {
          "table": "dwd_sales_f",
          "join_key_unique": false,
          "strategy": "CTE预聚合收敛",
          "reason": "销售事实表按product_id不唯一（每笔销售一行），需通过CTE(sales_agg)先按product_id聚合SUM后再关联"
        }
      ],
      "field_targets": [
        "purchase_id",
        "purchase_no",
        "purchase_status_name",
        "create_time",
        "supplier_id",
        "product_id",
        "purchase_qty",
        "purchase_price",
        "purchase_amount",
        "warehouse_id",
        "supplier_name",
        "supplier_level_name",
        "cooperation_years",
        "product_name",
        "warehouse_name",
        "warehouse_type_name",
        "current_stock_qty",
        "locked_qty",
        "stock_days",
        "del_flag",
        "crt_cycle_id",
        "last_upd_cycle_id",
        "dw_last_update_date"
      ],
      "field_logics": {
        "purchase_status_name": "采购状态码转中文映射：DRAFT→草稿，SUBMITTED→已提交，APPROVED→已审批，RECEIVED→已入库，CLOSED→已关闭，其余→其他",
        "supplier_level_name": "供应商等级码转中文映射：A→A级供应商，B→B级供应商，C→C级供应商，其余→其他",
        "purchase_amount": "采购金额 = 采购数量(purchase_qty) × 采购单价(purchase_price)",
        "warehouse_type_name": "仓库类型码转中文映射：SELF→自营仓，THIRD_PARTY→第三方仓，其余→其他",
        "stock_days": "库存周转天数 = (当前库存 - 锁定库存) / 近30天日均销量。近30天销量通过CTE(sales_agg)对销售表按product_id聚合SUM得到，除零保护用NULLIF(sales_qty_30d, 0)，结果为NULL或零时库存周转天数取NULL"
      }
    }
  },
