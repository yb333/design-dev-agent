{
  "default": "dws-dev",
  "sources": {
    "dws-dev": {
      "type": "huawei-dws",
      "host": "your-dws-cluster.huaweicloud.com",
      "port": 8000,
      "database": "your_database",
      "ssl": true,
      "sslrootcert": "/path/to/dws-ca.pem",
      "roles": {
        "admin": {
          "user": "your_admin_user",
          "password": "${DWS_DEV_ADMIN_PASSWORD}",
          "desc": "DDL 账号（建表/删表/建视图）"
        },
        "etl": {
          "user": "your_etl_user",
          "password": "${DWS_DEV_ETL_PASSWORD}",
          "desc": "数据读写账号（SELECT 查来源表/INSERT 写目标表/UT检查）"
        }
      }
    },
    "dws-prod": {
      "type": "huawei-dws",
      "host": "your-dws-prod-cluster.huaweicloud.com",
      "port": 8000,
      "database": "your_database",
      "ssl": true,
      "sslrootcert": "/path/to/dws-ca.pem",
      "roles": {
        "admin": {
          "user": "your_admin_user",
          "password": "${DWS_PROD_ADMIN_PASSWORD}",
          "desc": "DDL 账号（建表/删表/建视图）"
        },
        "etl": {
          "user": "your_etl_user",
          "password": "${DWS_PROD_ETL_PASSWORD}",
          "desc": "数据读写账号（SELECT 查来源表/INSERT 写目标表/UT检查）"
        }
      }
    }
  },
  "schema_mapping": {
    "fin_dwl_cnb": "dws-dev",
    "fin_dwb_isc": "dws-dev",
    "dwrdim_dw1": "dws-dev",
    "dws_rt": "dws-prod"
  },
  "test_params": {
    "_comment": "标准参数（P_CYCLE_ID/P_FLAG/P_START_DATE/P_END_DATE）默认值在 ts.json（脚本注入），无需在此配。此段仅用于覆盖特定参数（如开发库要用固定日期而非今天）。",
    "ACCT_PERIOD": {
      "type": "static",
      "value": "202608",
      "desc": "业务参数覆盖示例：开发环境手动指定（ts.default_value 已给默认，这里精确覆盖）"
    }
  },
  "security": {
    "allowWriteOperations": true,
    "maxRows": 1000,
    "timeout": 600,
    "sample_blocks": 0
  }
}
