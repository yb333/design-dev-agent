{
  "default": "dws-dev",
  "sources": {
    "dws-dev": {
      "type": "huawei-dws",
      "host": "your-dws-cluster.huaweicloud.com",
      "port": 8000,
      "database": "your_database",
      "ssl": true,
      "sslrootcert": "/path/to/dws-ca.pem",
      "roles": {
        "admin": {
          "user": "your_admin_user",
          "password": "${DWS_DEV_ADMIN_PASSWORD}",
          "desc": "DDL 账号（建表/删表/建视图）"
        },
        "etl": {
          "user": "your_etl_user",
          "password": "${DWS_DEV_ETL_PASSWORD}",
          "desc": "数据读写账号（SELECT 查来源表/INSERT 写目标表/UT检查）"
        }
      }
    },
    "dws-prod": {
      "type": "huawei-dws",
      "host": "your-dws-prod-cluster.huaweicloud.com",
      "port": 8000,
      "database": "your_database",
      "ssl": true,
      "sslrootcert": "/path/to/dws-ca.pem",
      "roles": {
        "admin": {
          "user": "your_admin_user",
          "password": "${DWS_PROD_ADMIN_PASSWORD}",
          "desc": "DDL 账号（建表/删表/建视图）"
        },
        "etl": {
          "user": "your_etl_user",
          "password": "${DWS_PROD_ETL_PASSWORD}",
          "desc": "数据读写账号（SELECT 查来源表/INSERT 写目标表/UT检查）"
        }
      }
    }
  },
  "schema_mapping": {
    "fin_dwl_cnb": "dws-dev",
    "fin_dwb_isc": "dws-dev",
    "dwrdim_dw1": "dws-dev",
    "dws_rt": "dws-prod"
  },
  "test_params": {
    "P_CYCLE_ID": {
      "type": "dynamic",
      "expr": "today_ymdhms",
      "desc": "批次号=当天0点拼000000，如 20260804000000"
    },
    "BIZ_DATE": {
      "type": "dynamic",
      "expr": "today_ymd",
      "desc": "业务日期=当天，如 20260804"
    },
    "ACCT_PERIOD": {
      "type": "static",
      "value": "202608",
      "desc": "会计期间（手动指定）"
    }
  },
  "security": {
    "allowWriteOperations": true,
    "maxRows": 1000,
    "timeout": 0
  }
}
