{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline_v1",
  "title": "baseline_v1 契约（vendor 拷贝）",
  "description": "dws-analyzer-skill 面向优化场景的投影产物。权威 schema 与说明在 analyzer 仓维护；本文件是本仓 vendor 拷贝，运行时版本对齐校验用。语义分级：事实（必填或显式空）/ hint（load_strategy、patterns，非权威）/ 语义（增量字段、驱动表、主键、粒度——永不进契约）。约定全文见 docs/specs/opt/09-契约-baseline_v1.md。",
  "type": "object",
  "required": ["version", "asset", "provenance", "rules", "tables", "lineage", "load_strategy", "warnings"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "契约版本，双端校验锚点。本仓当前支持 '1.0'。",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "asset": {
      "type": "object",
      "required": ["schema", "table", "rule_group_code", "rule_group_en", "dialect", "source_type", "analysis_time", "platform_generation"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "rule_group_code": { "type": "string" },
        "rule_group_en": { "type": "string" },
        "dialect": { "type": "string", "description": "oracle/dws/auto 等" },
        "source_type": { "type": "string", "description": "execution_tasks.xlsx / repo_yml 等——生产侧实现细节，消费方不感知" },
        "analysis_time": { "type": "string" },
        "platform_generation": { "type": "string", "description": "平台代次（如 '1.0'/'2.0'）；枚举映射表由消费方按代次维护" }
      }
    },
    "provenance": {
      "type": "array",
      "description": "原始源文件定位信息（路径清单，原则8）。交付方保证可达；消费方另有快照兜底仅作 patch 保险。",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["execution_tasks", "rule_yml", "ddl", "lts", "dq", "other"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_code", "exec_sequence", "scenario_id", "target_schema", "target_table", "delete_mode", "delete_condition", "query_sql", "source_tables"],
        "additionalProperties": false,
        "properties": {
          "rule_code": { "type": "string", "minLength": 1, "description": "平台稳定标识" },
          "rule_name": { "type": "string" },
          "exec_sequence": { "type": "integer" },
          "scenario_id": { "type": "string", "description": "多场景分组" },
          "is_common": { "type": "boolean" },
          "target_schema": { "type": "string", "minLength": 1 },
          "target_table": { "type": "string", "minLength": 1 },
          "delete_mode": { "type": "string", "description": "平台原始值逐字携带（'1'-'6'），不做语义归一；→load_mode 映射归消费方" },
          "delete_condition": { "type": "string", "description": "可空串；逐字原始值" },
          "merge_on": { "type": "string", "description": "MERGE ON 条件；delete_mode=6 时必供（schema 无法表达条件必填，由消费方代码强制 fail-loud）" },
          "query_sql": { "type": "string", "minLength": 1, "description": "SQL 原文，逐字保真（禁美化/重排版）" },
          "source_tables": { "type": "array", "items": { "type": "string" }, "description": "SQL 内物理表（schema.table）" },
          "joins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_table", "alias", "join_type"],
              "additionalProperties": false,
              "properties": {
                "source_table": { "type": "string" },
                "alias": { "type": "string" },
                "join_type": { "type": "string", "description": "FROM/LEFT/INNER/…（FROM=主表）" },
                "join_condition": { "type": "string" }
              }
            }
          },
          "where_clause": { "type": "string" },
          "group_by": { "type": "array", "items": { "type": "string" } },
          "is_view_step": { "type": "boolean" },
          "exchange_source_table": { "type": "string" }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "description": "SQL 涉及的全部表（含源表/中间表/目标表）",
      "items": {
        "type": "object",
        "required": ["schema", "name"],
        "additionalProperties": false,
        "properties": {
          "schema": { "type": "string" },
          "name": { "type": "string" },
          "fields": {
            "type": "array",
            "description": "DDL 可得则填，缺则空数组（类型回填由消费方查库，仅用于全量 DDL 生成）",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "comment": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_code", "target_field", "transform_type", "raw_expr", "physical_sources"],
        "additionalProperties": false,
        "properties": {
          "rule_code": { "type": "string" },
          "target_field": { "type": "string" },
          "transform_type": { "type": "string", "description": "生产方枚举（direct/aggregate/…）；围栏判定不锚定此标签（锚 raw_expr 原文）" },
          "raw_expr": { "type": "string", "description": "逐字表达式原文——围栏/血缘比对锚点" },
          "physical_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["table", "field"],
              "additionalProperties": false,
              "properties": {
                "table": { "type": "string", "description": "物理源表（CTE 穿透后）" },
                "field": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": ["object", "null"],
      "description": "代码仓模式可得；xlsx 模式为显式 null（缺口显式化，消费方报'无法断言调度不变'）",
      "additionalProperties": true
    },
    "dq_rules": {
      "type": ["array", "null"],
      "items": { "type": "object", "additionalProperties": true },
      "description": "存量 DQ；优化场景完全跟随输入，一般不动"
    },
    "load_strategy": {
      "type": "object",
      "description": "hint 级（资产级判定，非权威）",
      "additionalProperties": true
    },
    "patterns": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "description": "hint 级加工模式提示，给人看不进 ts"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title"],
        "additionalProperties": true,
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string" }
        }
      },
      "description": "逆向交叉验证差异事实（必填可空数组）；消费方式=报告+存档，不参与 patch 决策"
    }
  }
}
