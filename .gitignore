# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/

# Node
node_modules/
dist/

# DB 本地配置（含凭据，绝不进 git）
# 用户配置在 ~/.config/opencode/db-sources.json，不在项目里

# 评测：真实用例目录（内网本地放真实业务数据，不进仓库）
eval-suite/cases_real/

# 内网本地扩展区（pull-only 仓免冲突）：内网机器在此自由添加/修改脚本，
# git 永不跟踪、pull 永不冲突；install.py 按磁盘内容整目录拷贝，照样安装到
# ~/.config/opencode/。交付取码脚本 backfill_rule_codes.py 放这里（new-pipe 7b）。
# ★ 铁律：外网侧永远不要往这个路径提交被跟踪文件（否则内网 pull 因同名碰撞拒绝合并）。
skills/design-dev-shared/scripts/local/

# 评测：baseline 存档（每次跑评测生成，本地对比用，不进仓库）
eval-suite/results/

# 运行时产出（跑流水线/评测生成的 SQL/DDL/ts.json/xlsx，本地重新生成，不进仓库）
# ★ 例外：资产档案 archive/（文本小件入 git——资产当前态+演进史=git 提交记录）。
# 写法（gitignore 定式：被忽略目录内的路径无法白名单救回，目录须逐级放行）：
#   先忽略 deliver 下一切 → 放行全部目录（可遍历，内容仍忽略）→ 放行 archive 子树。
10_project_deliver/**
!10_project_deliver/**/
!10_project_deliver/**/ddlc_design_dev/archive/
!10_project_deliver/**/ddlc_design_dev/archive/**

# 测试隔离目录（conftest 自动创建，指向 DWS_RULES_DIR 避免测试碰机器全局 config）
tests/.test_rules_config/

# 运行时产出（skill 写入的工作目录，可重跑覆盖）
# 注：docs/output/dwl_con_pu_any_f 作为标准示例保留，其余忽略
docs/output/*
!docs/output/dwl_con_pu_any_f/

# 旧架构归档（迁移遗留，新系统完成后删除）
legacy/

# 开发时 skill 软链接（实际在 skills/，这里链接给 opencode 扫描）
.opencode/skills/

# 旧版 PPT（已被 architecture-overview.html 替代）
docs/ppt/agent-concept.html

# RS图转文原始文件（已还原为 RS模板.md）
docs/templates/RS（图转文）.md

# 临时文件
*.tmp
*.bak
*.backup

# 编辑器产物
.zcode/
