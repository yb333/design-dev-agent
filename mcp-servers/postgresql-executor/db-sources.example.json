{
  "default": "local-dev",
  "sources": {
    "local-dev": {
      "type": "postgresql",
      "host": "localhost",
      "port": 5432,
      "database": "your_database",
      "user": "your_user",
      "password": "your_password",
      "ssl": false
    },
    "dws-prod": {
      "type": "huawei-dws",
      "host": "your-dws-cluster.huaweicloud.com",
      "port": 8000,
      "database": "your_database",
      "user": "your_user",
      "password": "${DWS_PROD_PASSWORD}",
      "ssl": true,
      "sslrootcert": "/path/to/dws-ca.pem"
    }
  },
  "security": {
    "allowWriteOperations": false,
    "maxRows": 100,
    "timeout": 0
  }
}
